# ============================================================
# IntelliScrape — Environment variables (First Milestone: Auth)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file — it is already in .gitignore.
# ============================================================

# --- App metadata ---
APP_NAME=IntelliScrape Auth Service
ENVIRONMENT=development
# development | staging | production
DEBUG=true

# --- Database (Postgres) ---
# Used by docker-compose to configure the postgres container itself.
POSTGRES_USER=intelliscrape
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=intelliscrape_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full async SQLAlchemy connection string built from the values above.
# Inside docker-compose, host is the service name "postgres".
# When running the backend outside Docker, change host to "localhost".
DATABASE_URL=postgresql+asyncpg://intelliscrape:change_me_locally@postgres:5432/intelliscrape_db

# --- JWT / Auth ---
# Generate a strong random secret, e.g.: openssl rand -hex 32
# NEVER reuse this default in staging/production.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
# Access tokens are intentionally short-lived — they authorize API calls.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh tokens are long-lived and live in an HttpOnly cookie, never in JS.
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Cookie security ---
# Set COOKIE_SECURE=true in staging/production (requires HTTPS).
# Keep false only for local HTTP development.
COOKIE_SECURE=false
# Leave blank locally. In production set to your API's domain, e.g. api.intelliscrape.app
COOKIE_DOMAIN=

# --- Brute-force protection ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Redis (Celery broker + result backend) ---
# Inside docker-compose the host is the service name "redis";
# outside Docker (e.g. running the worker directly) use "localhost".
REDIS_URL=redis://redis:6379/0

# --- Job scraping: Greenhouse ---
# Comma-separated Greenhouse "board tokens" (the slug in a company's
# public careers URL, e.g. job-boards.greenhouse.io/stripe -> "stripe").
# Starting with 5 verified companies; add more here as you go — no
# code changes needed.
GREENHOUSE_COMPANY_TOKENS=stripe,gitlab,figma,robinhood,asana
